# ──────────────────────────────────────────────────────────────────────────────
# Clank RPG — environment. Copy to .env.local (never commit real values).
# Everything below is SERVER-ONLY except NEXT_PUBLIC_* (visible in the browser).
# ──────────────────────────────────────────────────────────────────────────────

# Public origin of the site (used for CSRF/origin checks and absolute URLs). It is also the CANONICAL origin of the public hero links
# (/heroes/<id>), the "Share to X" / "Copy link" actions and the Open Graph / social-card image URLs: set the real production origin there.
NEXT_PUBLIC_APP_URL=http://localhost:3700

# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (use the TRANSACTION POOLER, port 6543,
# for serverless hosting). This is a privileged server connection — never expose it to the browser.
# When unset in development, the app uses an embedded local database in .data/pglite (no Docker).
# In production this is REQUIRED; the app refuses to start without it.
# Vercel → the TRANSACTION pooler (6543). The arena worker / long scripts → a direct or session connection (5432).
# Rules the driver follows behind the pooler, and how to diagnose it: docs/DATABASE_CONNECTIONS.md.
# Optional tuning (safe defaults): DATABASE_POOL_MAX (8; use 1-2 behind a SESSION pooler), DATABASE_QUERY_TIMEOUT_MS (20000; 0 = off),
# DATABASE_TX_TIMEOUT_MS (120000; 0 = off).
DATABASE_URL=

# ── Secrets (generate each with:  openssl rand -base64 48) ────────────────────
# Signs player sessions and the admin session. >= 32 chars. REQUIRED in production.
SESSION_SECRET=
# Makes each member's class roll unpredictable (so a class cannot be farmed). >= 24 chars. REQUIRED in production.
CLASS_ROLL_SECRET=
# Keys the hash used to detect duplicate Telegram messages (message text is never stored). >= 16 chars. REQUIRED in production.
TELEGRAM_HASH_PEPPER=
# Admin console access key. >= 24 chars. If unset, the admin area is disabled.
ADMIN_ACCESS_KEY=
# Bearer secret for scheduler calls to /api/internal/tick (Vercel Cron sends it automatically). >= 24 chars.
CRON_SECRET=

# ── Telegram (official Clank.trade community ONLY) ────────────────────────────
# Bot token from @BotFather. The bot must be in the official group; make it an ADMIN to receive
# reactions, and disable privacy mode (or keep it admin) to see all messages.
# ALSO required for "Sign in with Telegram" (the server verifies the widget's signature with it): without it sign-in is unavailable
# (POST /api/auth/telegram → 503 LOGIN_UNAVAILABLE). Setting it does NOT turn the webhook on. See docs/PLAYER_AUTH.md.
TELEGRAM_BOT_TOKEN=
# Random string you choose (A-Z a-z 0-9 _ -, 16-256 chars). Sent back by Telegram on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Chat id of the official group, e.g. -1001234567890 (forward a group message to @RawDataBot to find it).
TELEGRAM_OFFICIAL_CHAT_ID=
# Bot username (without @) for the "Sign in with Telegram" widget. The domain must be set in @BotFather → /setdomain
# (production: www.clankrpg.fun, exactly the host the widget runs on). The widget is offered only when BOTH this and TELEGRAM_BOT_TOKEN are set.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# ── Hero profile photos (Supabase Storage) ────────────────────────────────────
# Project URL and the service_role key (Project Settings → API). SERVER ONLY — never expose the key to the browser.
# Needed in production for admin photo uploads and the Telegram photo cache. The bucket is private; the migration
# 20261005000900 creates it (or create `hero-avatars` by hand: private, png/jpeg/webp, 5 MB).
# Unset in development with the embedded database → images are stored under .data/avatars instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=hero-avatars

# ── Robinhood Chain / Clank.trade ─────────────────────────────────────────────
# Robinhood's public RPC is rate-limited and not recommended for production — use a dedicated provider.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
# Clank.trade public-app JSON (observed interface, not an official API — see docs/CLANK_DATA.md).
CLANK_TRADE_API_URL=https://clank.trade
# true = newly observed bonded coins become ELIGIBLE automatically; false (default) = an admin approves each one.
CLANK_AUTO_APPROVE_BONDED=false

# ── $CLANKRPG (Arena Picks) — SERVER-ONLY configuration ───────────────────────────────────────────────────────────────
# Arena Picks are FREE and Telegram is the account. Earning and accumulating rewards needs NONE of this. These settings only
# turn on (a) OPTIONAL holder verification (the signed wallet → balanceOf → the holder PRIZE BONUS on Daily/Weekly leaderboard prizes) and (b) the read-only
# check the admin console runs on a manual payout's transaction before marking a claim SENT. Unset (the token has not launched) or
# invalid → everyone is on FREE (no holder bonus), claims wait ("CLAIMS WILL OPEN AFTER $CLANKRPG LAUNCH") and the game carries on.
#
# TOKENS ARE PAID BY HAND. This app holds NO signing key and never sends a transaction — there is no private key to configure.
# (CLANKRPG_REWARD_TREASURY_PRIVATE_KEY is retired: if it is still set the admin console tells you to remove it.)
#
# The chain is the EXISTING Robinhood Chain configuration above (ROBINHOOD_RPC_URL / ROBINHOOD_CHAIN_ID) — there is no second
# RPC or chain-id setting for the token.
#
# The ONE official $CLANKRPG ERC-20 contract on Robinhood Chain (public). NOT invented here: set the real address when it exists.
# Clients never hard-code it and there is no NEXT_PUBLIC_ copy: they read it (and the BUY link) from GET /api/rewards/token.
CLANKRPG_TOKEN_ADDRESS=
# This is the ONLY token setting. Leave it EMPTY until $CLANKRPG launches: that is a normal state (everyone is on the FREE tier, 0 %
# bonus; the Arena, Picks, boards, Points, finalization and reward accounting all run; claims open after launch; the BUY $CLANKRPG
# button links to https://clank.trade/). Once it is set the same button links to https://clank.trade/<address>, and the server reads
# the contract's own symbol() and decimals() — nothing about the token's scale is configured, and rewards are accounted in LOGICAL
# amounts that do not depend on it.
# Optional, read-only: the wallet you pay rewards from, so the admin console can show its token balance and coverage.
CLANKRPG_REWARD_TREASURY_ADDRESS=
# Optional, public: a block-explorer transaction URL with a {hash} placeholder (shows "View tx" in a member's claim history).
CLANKRPG_EXPLORER_TX_URL=
# "simulated" = an in-memory chain (balances + transfers) for local development / QA only. Refused in production.
CLANKRPG_CHAIN_ADAPTER=

# ── Local development only ────────────────────────────────────────────────────
# Allows queueing the clearly-labelled DEV_SEED demo heroes (always on for the local embedded DB).
CLANK_ALLOW_DEMO_HEROES=
# Lets you sign in as a demo hero without Telegram. Impossible to enable when NODE_ENV=production.
CLANK_DEV_LOGIN=false
